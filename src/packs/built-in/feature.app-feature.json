{
  "schemaVersion": "1.0",
  "id": "feature.app-feature",
  "name": "App 功能设计",
  "description": "从用户问题到功能 PRD、页面状态、数据建议和验收标准。",
  "version": "1.0.0",
  "icon": "▦",
  "artifactKind": "product-feature",
  "source": "built-in",
  "inputFields": [
    { "id": "user_problem", "label": "用户问题", "type": "textarea", "required": true },
    { "id": "target_users", "label": "目标用户", "type": "tags", "required": true, "allowCustomValue": true },
    { "id": "use_scenarios", "label": "使用场景", "type": "textarea", "required": false },
    { "id": "mvp_scope", "label": "MVP 范围", "type": "tags", "required": false, "allowCustomValue": true },
    { "id": "page_states", "label": "页面状态", "type": "tags", "required": false, "allowCustomValue": true },
    { "id": "data", "label": "数据", "type": "textarea", "required": false },
    { "id": "risks", "label": "风险", "type": "tags", "required": false, "allowCustomValue": true },
    { "id": "acceptance", "label": "验收标准", "type": "textarea", "required": true }
  ],
  "flow": { "steps": [
    { "id": "input", "enabled": true }, { "id": "analysis", "enabled": true }, { "id": "directions", "enabled": true },
    { "id": "decisions", "enabled": true }, { "id": "review", "enabled": true }, { "id": "generate", "enabled": true }, { "id": "refine", "enabled": true }
  ], "directionConfig": { "count": 3, "allowSkip": false, "differenceDimensions": ["MVP 边界", "用户路径", "交付风险"], "minimumDifferenceCount": 2 } },
  "decisionModules": [
    { "id": "mvp_boundary", "title": "MVP 边界", "controlType": "single-select", "required": true, "optionSource": "preset", "options": [
      { "id": "lean", "label": "最小闭环", "description": "只保留验证核心价值的路径。" }, { "id": "balanced", "label": "可上线版本", "description": "兼顾首次上线所需的基础体验。" }, { "id": "complete", "label": "完整规划", "description": "为后续扩展保留清晰边界。" }
    ] },
    { "id": "flow_style", "title": "用户流程", "controlType": "single-select", "required": true, "optionSource": "ai-generated", "optionCount": 3 },
    { "id": "acceptance_level", "title": "验收颗粒度", "controlType": "multi-select", "required": true, "optionSource": "preset", "options": [
      { "id": "happy", "label": "主流程", "description": "覆盖从进入到完成的成功路径。" }, { "id": "empty", "label": "空状态", "description": "明确首次使用时的引导。" }, { "id": "error", "label": "异常状态", "description": "定义失败、重试与恢复。" }
    ] }
  ],
  "outputConfig": { "formats": ["md", "json"], "preview": "structured", "allowRefine": true },
  "compilerConfig": { "compilerId": "product-feature", "rendererId": "product-feature", "exporterIds": ["markdown", "json"] },
  "validationRules": [{ "id": "problem-required", "fieldId": "user_problem", "rule": "required", "message": "请先说明用户遇到的真实问题。" }],
  "createdAt": "2026-07-18T00:00:00.000Z", "updatedAt": "2026-07-18T00:00:00.000Z"
}
